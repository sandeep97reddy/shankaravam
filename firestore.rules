rules_version = '2';

// ShankaRavam — Spark Free Tier rules (plan §13, §22; ADMIN_HEAD_PLAN S1–S5).
// Deploy with: firebase deploy --only firestore:rules
// Money collections are delta-synced from Room; audio NEVER goes here.
// Master admin: sandeepreddyr97@gmail.com (Google-provider + verified pinned;
// client AdminConfig is UI gating only — this file is the boundary).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // S1 master-admin whitelist (ADMIN_HEAD_PLAN S1.1). Email alone is NOT
    // proof of Google login (email/password providers can claim any address),
    // so the rule pins the Google provider + verified flag. Client-side
    // AdminConfig.isGlobalHeadEmail() is UI gating only — this is the boundary.
    function isGlobalAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'sandeepreddyr97@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function memberRole(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role;
    }

    function memberStatus(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.status;
    }

    function isActiveMember(eventId) {
      return signedIn() && memberStatus(eventId) == 'active';
    }

    function isCollector(eventId) {
      return isActiveMember(eventId)
        && memberRole(eventId) in ['global_head', 'organizer'];
    }

    // Event creator (globalHeadId stamped at creation): unblocks the very
    // first sync — a fresh event has no members yet, so isCollector alone
    // would deadlock the creator with PERMISSION_DENIED.
    function isEventCreator(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId)).data.globalHeadId == request.auth.uid;
    }

    function canWriteLedger(eventId) {
      return isCollector(eventId) || isEventCreator(eventId);
    }

    // S1: collectors may approve a PENDING request to active collector/viewer,
    // but NOTHING else — no head promotion, no revoke, no edits to active
    // members. Head/creator path below covers those. Keeps multi-counter
    // approval working while the head is offline (ADMIN_HEAD_PLAN S1.2).
    function isApprovePendingToActive(eventId) {
      return isCollector(eventId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'active'
        && request.resource.data.role in ['organizer', 'member'];
    }

    function codeDoc(code) {
      return get(/databases/$(database)/documents/codes/$(code)).data;
    }

    // Server-side invite liveness: the stamped viaCode must resolve to a code
    // doc for THIS event that is still active and unexpired. Mirrors the
    // client isCodeLive() (ShareCodes.kt). Grandfathering: docs without a
    // status/expiresAt (pre-expiry codes) count as live; legacy numeric
    // expiresAt values are unreadable against request.time, so they also pass
    // here — only Timestamp expiries (written by current builds) are compared.
    // Client-side isCodeLive stays the friendly gate; this is the boundary.
    function codeNotExpired(data) {
      return !('expiresAt' in data)
        || (data.expiresAt is timestamp && data.expiresAt > request.time)
        || (data.expiresAt is number);
    }

    function isLiveCode(code, eventId) {
      return code is string && code.size() == 6
        && exists(/databases/$(database)/documents/codes/$(code))
        && codeDoc(code).eventId == eventId
        && (!('status' in codeDoc(code)) || codeDoc(code).status == 'active')
        && codeNotExpired(codeDoc(code));
    }

    // ---- event headers: active members + creator read; doc-holding members
    // (incl. pending joiners, S3 addendum) may read the header so a second
    // Google account's join resolves after filing membership. Ledger reads
    // below stay active-only — pending still can't see money. ----
    match /events/{eventId} {
      allow read: if isActiveMember(eventId) || isEventCreator(eventId)
        || (signedIn() && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)));
      allow create: if signedIn();
      allow update: if canWriteLedger(eventId);

      // ---- ledger: collectors write, active members read; corrections append-only ----
      match /donations/{donationId} {
        allow read: if isActiveMember(eventId) || isEventCreator(eventId);
        allow create, update: if canWriteLedger(eventId);
        allow delete: if false;
      }
      match /expenses/{expenseId} {
        allow read: if isActiveMember(eventId) || isEventCreator(eventId);
        allow create, update: if canWriteLedger(eventId);
        allow delete: if false;
      }
      match /corrections/{correctionId} {
        allow read: if isActiveMember(eventId) || isEventCreator(eventId);
        allow create: if canWriteLedger(eventId);
        allow update, delete: if false;
      }
      match /activity/{activityId} {
        allow read: if isActiveMember(eventId) || isEventCreator(eventId);
        allow create: if isActiveMember(eventId) || isEventCreator(eventId);
        allow update, delete: if false;
      }

      // ---- membership (S1 hardened): self file pending/member; creator claims
      // own active/global_head seat; whitelisted admin auto-claims head on any
      // festival; updates are head/creator full-manage, collectors approve
      // pending→active (organizer/member only), self may merge-touch presence
      // + identity keys without changing role/status. No deletes.
      // Joins must stamp viaCode (the invite used) — the pending/member
      // create path verifies it is live for this event (status + expiry +
      // event match), so expired/closed/forged codes fail server-side even
      // when the client check is bypassed. ----
      match /members/{userId} {
        allow read: if signedIn()
          && (isActiveMember(eventId) || request.auth.uid == userId || isGlobalAdmin());
        allow create: if signedIn()
          && request.auth.uid == userId
          && (
            (
              request.resource.data.status == 'pending'
              && request.resource.data.role == 'member'
              && 'viaCode' in request.resource.data
              && isLiveCode(request.resource.data.viaCode, eventId)
            ) || (
              isEventCreator(eventId)
              && request.resource.data.status == 'active'
              && request.resource.data.role == 'global_head'
            ) || (
              isGlobalAdmin()
              && request.resource.data.status == 'active'
              && request.resource.data.role == 'global_head'
            )
          );
        allow update: if isGlobalAdmin() || isEventCreator(eventId)
          || isApprovePendingToActive(eventId)
          || (
            signedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastActiveAt', 'counterName', 'deviceTag', 'displayName', 'email', 'viaCode'])
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
          );
        allow delete: if false;
      }
    }

    // ---- invite codes (S1): anyone signed in resolves; first publisher owns
    // (createdBy == self); only the creator or the master admin may overwrite.
    // Second publisher's bare .set() is an update and correctly fails. ----
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isGlobalAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if false;
    }

    // ---- shared voice key (S1 model (a): global singleton, master-admin-only
    // writes). Readable by any signed-in device so the announcer can pull.
    // Non-admin heads see a graceful "saved on this device only" fallback
    // until S4 re-gates the Publish button. Per-event keys need a per-event
    // config path (deferred — see UI_FIX_PLAN P4).
    // Audio itself never goes here (AGENTS.md Rule #2). ----
    match /config/tts_settings {
      allow read: if signedIn();
      allow write: if isGlobalAdmin();
    }
  }
}
